PORT=5000
NODE_ENV=development
MONGO_URI=

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN=https://your-frontend.example,http://127.0.0.1:5176,http://localhost:5176
# Use * only if the live frontend URL is not fixed yet.
# CORS_ORIGIN=*

# Optional. If set, requests to /dashboard and admin CRUD endpoints must include:
# Authorization: Bearer your-secret-token
ADMIN_API_TOKEN=

# Admin login. Generate ADMIN_PASSWORD_HASH with: npm run hash-password -- your-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
ADMIN_SESSION_HOURS=8

# Optional custom path for JSON persistence.
DATA_FILE=./data/db.json

# Public API base URL used for callbacks.
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Email notifications with Nodemailer.
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WCDI <no-reply@example.com>"
ADMIN_EMAIL=

# Paystack. Use test keys while developing.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://127.0.0.1:5176/donate

# M-Pesa Daraja STK Push.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=
MPESA_ACCOUNT_REFERENCE=WCDI
MPESA_TRANSACTION_DESCRIPTION=WCDI Donation
