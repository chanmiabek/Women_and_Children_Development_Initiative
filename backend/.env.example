PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend.example
ADMIN_EMAIL=your-admin@gmail.com
ADMIN_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_SESSION_HOURS=8
ADMIN_OTP_MINUTES=10
DATA_FILE=./data/db.json

# Gmail SMTP: use a Google App Password, not your Gmail account password.
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-admin@gmail.com
SMTP_PASS=your-16-character-google-app-password
MAIL_FROM=your-admin@gmail.com

# Required only for admin CMS image uploads.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
